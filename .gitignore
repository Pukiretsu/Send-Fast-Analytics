# ==========================================
# 1. INFRAESTRUCTURA (Terraform / IaC)
# ==========================================
# Directorios de trabajo locales 
.terraform/

# Archivos de estado 
*.tfstate
*.tfstate.*
crash.log

# Variables sensibles 
*.tfvars
*.tfvars.json
override.tf
override.tf.json
.terraformrc
terraform.rc

# ==========================================
# 2. BACKEND (Python / AWS Lambda)
# ==========================================
# Entornos virtuales
venv/
.venv/
env/
ENV/

# Caché y compilados de Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Logs y bases de datos locales
*.log
*.sqlite

# Frameworks Serverless
.aws-sam/
.serverless/

# ==========================================
# 3. FRONTEND (React)
# ==========================================
# Dependencias de Node
node_modules/
/jspm_packages/

# Builds de producción
build/
dist/
out/

# Logs de error
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# 4. VARIABLES DE ENTORNO Y SECRETOS
# ==========================================
# NUNCA subir archivos .env con API Keys o AWS Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==========================================
# 5. HERRAMIENTAS Y SISTEMA (IDE/OS)
# ==========================================
# Archivos de configuración de editores (Neovim/VSCode/JetBrains)
.vscode/
.idea/
*.swp
*.swo
*~
.netrwhist

# Archivos de sistema
.DS_Store
Thumbs.db

# Planes y outputs locales de Terraform
*.tfplan
tfplan
tfoutputs.json

# Artefactos generados de Lambdas
modules/lambda/files/*.zip

# Env generados por CI/CD
.env.production
.env.staging
